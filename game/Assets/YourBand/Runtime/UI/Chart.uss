/* The desktop chart (see docs/plan.md, "Desktop mode"). Sizes are for a 1920 x 1080 screen; the panel scales. */

:root {
    --gt-text: #e8eaed;
    --gt-dim: #8b939d;
    --gt-faint: #5a626c;
    --gt-accent: #f2a93b;
    --gt-card: rgba(31, 35, 41, 0.92);
    --gt-card-border: #2f363f;
}

.gt-root {
    flex-grow: 1;
    padding: 18px 40px 14px 40px;
    color: var(--gt-text);
}

/* ------------------------------------------------------------ header */
.gt-header {
    flex-direction: row;
    align-items: flex-end;
    padding-bottom: 12px;
}
.gt-title {
    font-size: 34px;
    -unity-font-style: bold;
}
.gt-artist {
    font-size: 24px;
    color: var(--gt-dim);
    margin-left: 16px;
    padding-bottom: 3px;
}
.gt-status {
    font-size: 22px;
    color: var(--gt-dim);
    margin-left: auto;
    padding-bottom: 3px;
}
.gt-status--playing {
    color: var(--gt-text);
}

/* ------------------------------------------------------------ panels */
.gt-middle {
    flex-grow: 1;
    flex-shrink: 0;  /* as tall as its panels, so a second row of them never runs under the tab strip */
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    align-content: flex-start;
}
.gt-panel {
    background-color: var(--gt-card);
    border-color: var(--gt-card-border);
    border-width: 1px;
    border-radius: 10px;
    padding: 10px 16px 14px 16px;
    margin: 0 16px 16px 0;
}
.gt-panel__title {
    font-size: 17px;
    color: var(--gt-dim);
    -unity-font-style: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}
.gt-panel__row {
    flex-direction: row;
}
.gt-panel__empty {
    font-size: 18px;
    color: var(--gt-faint);
}

.gt-chord-card {
    margin-right: 10px;
    padding: 4px 4px 2px 4px;
    border-radius: 8px;
    border-top-width: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
.gt-chord-card--now {
    background-color: rgba(242, 169, 59, 0.14);
    border-left-color: var(--gt-accent);
    border-right-color: var(--gt-accent);
    border-bottom-color: var(--gt-accent);
}
.gt-chord-card--next {
    border-left-color: var(--gt-faint);
    border-right-color: var(--gt-faint);
    border-bottom-color: var(--gt-faint);
}
.gt-chord-card__tag {
    font-size: 14px;
    color: var(--gt-dim);
    -unity-text-align: middle-center;
    height: 18px;
}
.gt-diagram__name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gt-diagram__mark {
    margin: 0;
    padding: 0;
    position: absolute;
    font-size: 17px;
    color: var(--gt-dim);
    -unity-text-align: middle-center;
}
.gt-diagram__finger {
    margin: 0;
    padding: 0;
    position: absolute;
    font-size: 13px;
    color: #15181c;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gt-diagram__fret {
    margin: 0;
    padding: 0;
    position: absolute;
    font-size: 14px;
    color: var(--gt-dim);
    -unity-text-align: middle-right;
}

.gt-strum__count {
    margin: 0;
    padding: 0;
    position: absolute;
    font-size: 20px;
    color: var(--gt-dim);
    -unity-text-align: middle-center;
}
.gt-strum__count--beat {
    color: var(--gt-text);
    -unity-font-style: bold;
}
.gt-strum__origin {
    position: absolute;
    right: 14px;
    bottom: 8px;
    font-size: 14px;
    color: var(--gt-faint);
}
.gt-strum__name {
    font-size: 15px;
    color: var(--gt-faint);
    margin-top: 6px;
}

.gt-panel--across {
    width: 100%;
    margin-right: 0;
}
.gt-panel--lying {
    width: 100%;
    margin-right: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.gt-panel--lying .gt-panel__title {
    margin-bottom: 0;
    margin-right: 28px;
}
.gt-panel--lying .gt-info__row {
    margin-bottom: 0;
    margin-right: 28px;
}
.gt-panel--lying .gt-info__key {
    width: auto;
    margin-right: 8px;
}
.gt-info__row {
    flex-direction: row;
    margin-bottom: 2px;
}
.gt-info__key {
    font-size: 18px;
    color: var(--gt-dim);
    width: 84px;
}
.gt-info__value {
    font-size: 18px;
}

/* ------------------------------------------------------------ chart strip */
.gt-chart {
    background-color: var(--gt-card);
    border-color: var(--gt-card-border);
    border-width: 1px;
    border-radius: 12px;
    padding: 12px 18px 12px 18px;
}

.gt-sections {
    flex-direction: row;
    flex-shrink: 0;
    height: 34px;
    margin-bottom: 12px;
}
.gt-section {
    border-radius: 5px;
    margin-right: 3px;
    background-color: rgba(255, 255, 255, 0.06);
    justify-content: center;
    overflow: hidden;
}
.gt-section:hover {
    background-color: rgba(255, 255, 255, 0.12);
}
.gt-section--now {
    background-color: rgba(242, 169, 59, 0.28);
}
.gt-section__name {
    font-size: 15px;
    color: var(--gt-dim);
    padding-left: 8px;
    white-space: nowrap;
}
.gt-section--now .gt-section__name {
    color: var(--gt-text);
    -unity-font-style: bold;
}
.gt-sections__cursor {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 3px;
    background-color: var(--gt-accent);
}

/* the chart's rows: two in view, the one being played on top */
.gt-rows {
    height: 384px;
    flex-shrink: 1;
    min-height: 260px;
    overflow: hidden;
}
.gt-row {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    padding-top: 4px;
}
.gt-row__section {
    font-size: 16px;
    height: 22px;
    color: var(--gt-faint);
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.gt-row__section--start {
    color: var(--gt-accent);
}
.gt-row__cells {
    flex-direction: row;
    flex-grow: 1;
}
.gt-cell {
    padding: 2px 10px 0 8px;
    border-left-width: 1px;
    border-left-color: var(--gt-card-border);
}
.gt-cell--now {
    background-color: rgba(242, 169, 59, 0.045);
}
.gt-cell__head {
    height: 22px;
}
.gt-cell__number {
    position: absolute;
    right: 0;
    font-size: 15px;
    color: var(--gt-text);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}
.gt-cell__beats {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.gt-cell__beat {
    position: absolute;
    font-size: 15px;
    color: var(--gt-faint);
    padding: 0;
    margin: 0;
}
.gt-cell__beat--now {
    color: var(--gt-accent);
    -unity-font-style: bold;
}
.gt-cell__chords {
    height: 66px;
}
.gt-cell__chord {
    position: absolute;
    bottom: 0;
    font-size: 52px;
    -unity-font-style: bold;
    white-space: nowrap;
}
.gt-cell__chord--held {
    color: var(--gt-faint);
}
.gt-cell__track {
    height: 22px;
    margin-top: 2px;
}
.gt-cell__words {
    height: 46px;
    margin-top: 4px;
}
.gt-cell__word {
    position: absolute;
    font-size: 32px;
    white-space: nowrap;
}
.gt-cell__word--sung {
    color: var(--gt-accent);
}
.gt-cell__word--backing {
    color: var(--gt-dim);
    -unity-font-style: italic;
}
.gt-cell__word--backing.gt-cell__word--sung {
    color: rgba(242, 169, 59, 0.65);
}
.gt-cell__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.gt-cell__count {
    position: absolute;
    right: 16px;
    top: 18px;
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--gt-accent);
}

/* the tab, across the screen above the chart */
.gt-tabstrip {
    background-color: var(--gt-card);
    border-color: var(--gt-card-border);
    border-width: 1px;
    border-radius: 12px;
    padding: 8px 18px 6px 18px;
    margin-bottom: 12px;
    flex-shrink: 0;  /* the chart's rows give way when the panels above need the room */
}
.gt-tape {
    overflow: hidden;
}
.gt-tape__tape {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}
.gt-tape__fret {
    position: absolute;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(31, 35, 41, 1);
    padding: 0 2px 0 2px;
    margin: 0;
    height: 22px;
}
.gt-tape__riff {
    position: absolute;
    top: 0;
    font-size: 14px;
    color: var(--gt-dim);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}
.gt-tape__bar {
    position: absolute;
    top: 0;
    font-size: 15px;
    color: var(--gt-text);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}
.gt-tape__marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--gt-accent);
}
.gt-tape__names {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(31, 35, 41, 1);
}
.gt-tape__string {
    position: absolute;
    left: 0;
    width: 24px;
    height: 20px;
    font-size: 14px;
    color: var(--gt-faint);
    -unity-text-align: middle-right;
    padding: 0;
    margin: 0;
}
.gt-tape__empty {
    position: absolute;
    left: 40%;
    top: 40%;
    font-size: 17px;
    color: var(--gt-faint);
    background-color: rgba(31, 35, 41, 1);
    padding: 0 8px 0 8px;
}

/* ------------------------------------------------------------ loading */
.gt-loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 16, 20, 0.88);
    align-items: center;
    justify-content: center;
}
.gt-loading__text {
    font-size: 22px;
    color: var(--gt-dim);
    margin-top: 22px;
}

/* ------------------------------------------------------------ footer, help */
.gt-hint {
    font-size: 16px;
    color: var(--gt-faint);
    flex-shrink: 1;
    overflow: hidden;
}
.gt-footer {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 8px;
}
.gt-version {
    font-size: 14px;
    color: var(--gt-faint);
    margin-left: auto;
    padding-left: 24px;
    flex-shrink: 0;
}
.gt-help {
    position: absolute;
    right: 40px;
    top: 80px;
    background-color: #14161a;
    border-color: var(--gt-accent);
    border-width: 1px;
    border-radius: 10px;
    padding: 16px 22px 16px 22px;
}
.gt-help__row {
    flex-direction: row;
    margin-bottom: 3px;
}
.gt-help__keys {
    font-size: 19px;
    width: 190px;
    color: var(--gt-accent);
}
.gt-help__what {
    font-size: 19px;
}
.gt-matrix {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 80px;
    background-color: #14161a;
    border-color: var(--gt-accent);
    border-width: 1px;
    border-radius: 10px;
    padding: 14px 20px 18px 20px;
}
.gt-matrix__head {
    flex-direction: row;
    align-items: flex-end;
}
.gt-matrix__hint {
    font-size: 15px;
    color: var(--gt-faint);
    margin-left: 16px;
    margin-bottom: 8px;
}
.gt-matrix__body {
    flex-direction: row;
}
.gt-matrix__corner {
    height: 22px;
}
.gt-matrix__row {
    flex-direction: row;
    height: 24px;
    align-items: center;
    padding-right: 10px;
}
.gt-matrix__name {
    font-size: 16px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.gt-matrix__role {
    font-size: 14px;
    color: var(--gt-dim);
    margin: 0 0 0 auto;
    padding: 0 0 0 8px;
    white-space: nowrap;
}
.gt-matrix__area {
    flex-grow: 1;
}
.gt-matrix__sections {
    height: 22px;
}
.gt-matrix__section {
    position: absolute;
    top: 0;
    font-size: 13px;
    color: var(--gt-dim);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}
.gt-matrix__cursor {
    position: absolute;
    top: 18px;
    bottom: 0;
    width: 3px;
    margin-left: -1px;
    background-color: var(--gt-accent);
}
.gt-hidden {
    display: none;
}
