<Project Sdk="Microsoft.NET.Sdk">

  <!-- A command-line front end for the game's core code (game/Assets/GuitarTutor/Core): import and inspect songs
       without starting Unity. The core is compiled straight from the game's sources, with the C# version Unity
       uses, so nothing here can drift from the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>songtool</AssemblyName>
    <RootNamespace>GuitarTutor.SongTool</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../game/Assets/GuitarTutor/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- the Newtonsoft.Json that Unity's package ships (no download): run the game project once so it exists -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$([System.IO.Directory]::GetDirectories('$(MSBuildThisFileDirectory)../../game/Library/PackageCache', 'com.unity.nuget.newtonsoft-json@*')[0])/Runtime/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
